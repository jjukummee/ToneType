APP_ENV=production
APP_VERSION=1.0.0
ENABLE_API_DOCS=false
ALLOWED_HOSTS=api.example.com

GOOGLE_CLOUD_PROJECT_NUMBER=YOUR_PROJECT_NUMBER
GOOGLE_CLOUD_LOCATION=YOUR_RECOGNIZER_REGION
GOOGLE_SPEECH_RECOGNIZER_ID=YOUR_RECOGNIZER_ID
# Use this for the Gemini Developer API. Keep it server-side only.
GOOGLE_GENAI_API_KEY=
# Or omit the API key and use Vertex AI with ADC.
GOOGLE_GENAI_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT_ID
GOOGLE_GENAI_LOCATION=global
GOOGLE_GENAI_MODEL=gemini-2.5-flash
# Optional: leave empty to use the recognizer's configured model.
GOOGLE_SPEECH_MODEL=
